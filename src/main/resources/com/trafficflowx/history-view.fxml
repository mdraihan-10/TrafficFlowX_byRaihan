<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.trafficflowx.controller.HistoryController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-bar">
            <Button fx:id="backButton" onAction="#onBackClicked"
                    styleClass="secondary-button" text="← Back" />
            <Label styleClass="screen-title" text="Simulation History" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="clearButton" onAction="#onClearClicked"
                    styleClass="danger-button" text="Clear History" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label fx:id="statusLabel" styleClass="hint-label" text="" />

            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date / Time" />
                    <TableColumn fx:id="durationColumn" prefWidth="80.0" text="Duration" />
                    <TableColumn fx:id="densityColumn" prefWidth="80.0" text="Density" />
                    <TableColumn fx:id="totalColumn" prefWidth="60.0" text="Total" />
                    <TableColumn fx:id="passedColumn" prefWidth="65.0" text="Passed" />
                    <TableColumn fx:id="avgWaitColumn" prefWidth="80.0" text="Avg Wait" />
                    <TableColumn fx:id="maxWaitColumn" prefWidth="80.0" text="Max Wait" />
                    <TableColumn fx:id="emergencyColumn" prefWidth="85.0" text="Emergency" />
                    <TableColumn fx:id="accidentsColumn" prefWidth="80.0" text="Accidents" />
                    <TableColumn fx:id="roadBlocksColumn" prefWidth="95.0" text="Road Blocks" />
                    <TableColumn fx:id="conflictsColumn" prefWidth="80.0" text="Conflicts" />
                    <TableColumn fx:id="adaptiveColumn" prefWidth="70.0" text="Adaptive" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>